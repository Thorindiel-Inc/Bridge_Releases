Attribute VB_Name = "KILAVUZ"
Option Explicit
' ============================================================================
'  KILAVUZ - the manuals inside the workbook. GENERATED by tools/make_manuals.py: do not edit.
'  KILAVUZ_AC (button): writes the pages to %TEMP%\bridge_manuals, opens index.html in the browser.
'  KILAVUZ_YAZ outDir: writes the pages only (tests).
'  The text is plain ASCII (other letters as HTML codes), so any Windows code page works.
' ============================================================================

Private Const SCRIPT_ID As String = "manuals"
Private Const SCRIPT_VERSION As String = "2026-11-09c"
Private Const SCRIPT_CHANGELOG As String = "Macros read the span sheets, no 4-7 file; manuals inside the workbook: MIDAS_KOPRU and MIDAS_USTYAPI, button opens them in the browser"

Public Sub KILAVUZ_AC()
    Dim d As String
    On Error GoTo Fail
    d = Environ$("TEMP") & "\bridge_manuals"
    WriteAll d
    ThisWorkbook.FollowHyperlink d & "\index.html"
    Exit Sub
Fail:
    UiMsg "Manuals: " & Err.Description, vbExclamation, "KILAVUZ"
End Sub

Public Sub KILAVUZ_YAZ(ByVal outDir As String)
    WriteAll outDir
End Sub

Private Sub WriteAll(ByVal d As String)
    If Dir$(d, vbDirectory) = "" Then MkDir d
    WriteText d & "\midas-kopru-manual.html", P1_1() & P1_2() & P1_3() & P1_4() & P1_5()
    WriteText d & "\midas-ustyapi-manual.html", P2_1() & P2_2() & P2_3() & P2_4() & P2_5()
    WriteText d & "\index.html", P3_1()
End Sub

Private Sub WriteText(ByVal p As String, ByVal t As String)
    Dim f As Integer
    f = FreeFile
    Open p For Output As #f
    Print #f, t;
    Close #f
End Sub

